# ── ICT live bot credentials ────────────────────────────────────────────────
# Copy this file to `live.env` (which is git-ignored) and fill in your values.
# START ON A DEMO ACCOUNT. Never commit live.env — it holds your password.
#
#   PowerShell:  Copy-Item live.env.example live.env   (then edit live.env)

# Exness MT5 account (DEMO first). The server name is shown in the MT5 account
# panel, e.g. Exness-MT5Trial14.
MT5_LOGIN=12345678
MT5_PASSWORD=your-demo-password
MT5_SERVER=Exness-MT5Trial14

# Optional: full path to terminal64.exe. If set, run_live.ps1 will launch MT5
# automatically when it isn't already running. Adjust to your install path.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe

# Telegram alerts (optional but strongly recommended so you get trade/halt pings
# without watching the screen). Create a bot via @BotFather, get the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
